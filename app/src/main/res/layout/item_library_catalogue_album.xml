<?xml version="1.0" encoding="utf-8"?>
<!-- A plain vertical stack: grid tiles are laid out a page at a time when the A–Z strip jumps,
     and a ConstraintLayout with a ratio cost several times as much to measure. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <com.eddyizm.tempus.helper.recyclerview.SquareImageView
        android:id="@+id/album_catalogue_cover_image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/album_name_label"
        style="@style/CatalogueTileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingTop="8dp"
        android:singleLine="true"
        app:emojiCompatEnabled="false" />

    <TextView
        android:id="@+id/artist_name_label"
        style="@style/CatalogueTileSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        app:emojiCompatEnabled="false" />

</LinearLayout>
