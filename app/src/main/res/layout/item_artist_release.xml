<?xml version="1.0" encoding="utf-8"?>
<!-- One release on an artist's page: tap to open it, or expand to list its tracks in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/release_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/release_cover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/release_title"
                style="@style/CatalogueTileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/release_subtitle"
                style="@style/CatalogueTileSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true" />

            <!-- Favourite and download the whole album, under its year and track count. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/release_favorite_button"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/album_favorite_add"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_outlined"
                    app:tint="?attr/colorOnSurface" />

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="36dp">

                    <ImageButton
                        android:id="@+id/release_download_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/album_page_download_button"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_file_download"
                        app:tint="?attr/colorOnSurface" />

                    <!-- While the album downloads, in place of the button; tap it for the queue. -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/release_download_progress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="@string/download_queue_title"
                        android:focusable="true"
                        android:visibility="gone"
                        app:indicatorSize="20dp"
                        app:trackThickness="3dp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/release_play_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/album_page_play_button"
            android:src="@drawable/ic_play"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/release_queue_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/album_page_queue_button"
            android:src="@drawable/ic_queue_q" />


        <ImageButton
            android:id="@+id/release_expand_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/artist_release_show_tracks"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/release_tracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />
</LinearLayout>
