<?xml version="1.0" encoding="utf-8"?>
<!-- An album's download progress in place of its toolbar download button; tap for the download queue. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/download_queue_title"
    android:focusable="true">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/action_download_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        app:indicatorSize="22dp"
        app:trackThickness="3dp" />
</FrameLayout>
