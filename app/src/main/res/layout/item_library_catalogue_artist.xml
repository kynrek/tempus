<?xml version="1.0" encoding="utf-8"?>
<!-- A plain vertical stack, cheaper to measure than a ConstraintLayout ratio when the A–Z strip
     lays out a page of tiles at once. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.eddyizm.tempus.helper.recyclerview.SquareImageView
        android:id="@+id/artist_catalogue_cover_image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/artist_name_label"
        style="@style/CatalogueTileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:singleLine="true"
        app:emojiCompatEnabled="false" />

</LinearLayout>
