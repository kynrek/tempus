<?xml version="1.0" encoding="utf-8"?>
<!-- Condensed album row: small cover, then title and artist. Same ids and view types as
     item_library_catalogue_album so ItemLibraryCatalogueAlbumBinding.bind() works on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.eddyizm.tempus.helper.recyclerview.SquareImageView
        android:id="@+id/album_catalogue_cover_image_view"
        android:layout_width="52dp"
        android:layout_height="52dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/album_name_label"
            style="@style/CatalogueTileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            app:emojiCompatEnabled="false" />

        <TextView
            android:id="@+id/artist_name_label"
            style="@style/CatalogueTileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            app:emojiCompatEnabled="false" />
    </LinearLayout>
</LinearLayout>
