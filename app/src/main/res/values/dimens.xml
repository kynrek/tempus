    <dimen name="catalogue_header_height">104dp</dimen>
    <!-- The same header on a Home tab, where only its sort and filter buttons remain. -->
    <dimen name="embedded_header_height">64dp</dimen>
    <!-- Mini player transport buttons, large enough to hit while driving (the bar is 72dp, timeline included). -->
    <dimen name="mini_player_button_size">38dp</dimen>
